# Copy this file to .env when using the release folder from Git.
# The release ZIP already includes an empty .env template.
RULESHELF_VERSION=0.1.0
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Required: set your own random password (at least 32 letters/numbers).
# Use only A-Z, a-z, 0-9, _ and - so it is safe in the database URL.
# Keep this password unchanged while using the existing database volume.
POSTGRES_PASSWORD=

# Optional: YOUR OpenAI key. Leave empty for local rule search.
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_PROCESSING_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_PROCESSING_ENABLED=true
AI_MAX_CHUNKS=2000
AI_MAX_CHARACTERS=600000
MAX_UPLOAD_MB=50
MAX_DOCUMENT_PAGES=100
